# 로컬에서 시험할 때: 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 깃에 올라가지 않습니다)
# GitHub Actions에서는 같은 이름으로 Secrets / Variables에 등록합니다.

# ── 필수 키 ─────────────────────────────
ANTHROPIC_API_KEY=

# ── 사실상 필수 (무료): 검색어를 뉴스로 확인 ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 트렌드 수집원 (쓸 것만 쉼표로 나열. 자세한 설명은 README의 '수집원' 표) ──
TREND_SOURCES=google,daum,zum,signal,google_news,youtube,dcinside,x
# 유튜브 인기 동영상용 (무료 발급). 없으면 youtube만 건너뜁니다
YOUTUBE_API_KEY=
# X 트렌드용 (유료). 없으면 x만 건너뜁니다
X_BEARER_TOKEN=

# ── AI 이미지: 표지 1장 + 본문 카드마다 1장 (키가 없으면 이미지 없는 기본 디자인) ──
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
# low / medium / high — 낮출수록 싸고 빠릅니다
IMAGE_QUALITY=medium
# false면 표지에만 이미지를 넣습니다
CARD_IMAGES=true

# ── 인스타그램 (실제 게시할 때만 필요) ──
IG_USER_ID=
IG_ACCESS_TOKEN=

# ── 마스코트 ────────────────────────────
# true: 샴고양이 마스코트가 설명하는 말풍선 디자인 / false: 주제 이미지 + 어두운 디자인
MASCOT=true

# ── 운영 설정 ───────────────────────────
# false로 바꿔야 실제 게시됩니다
DRY_RUN=true
CHANNEL_NAME=지금뜨는
# 예: @my.channel
CHANNEL_HANDLE=
ACCENT_COLOR=#E8643C
# 예: 1-6 (KST 01~06시에는 게시 안 함)
QUIET_HOURS=
MAX_POSTS_PER_DAY=24
CLAUDE_MODEL=claude-sonnet-5-5

# ── 선택: Threads 반응 수집 (Meta 앱 심사에서 threads_keyword_search 승인 필요) ──
THREADS_ACCESS_TOKEN=
